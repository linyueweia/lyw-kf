	pcie3-regulator {
		compatible = "regulator-fixed";
		regulator-max-microvolt = <0x325aa0>;
		gpio = <&{/pinctrl/gpio@fdd60000} 0x1c 0x00>;
		regulator-min-microvolt = <0x325aa0>;
		regulator-name = "pcie3_power";
	};
	minipcie-regulator {
		compatible = "regulator-fixed";
		regulator-max-microvolt = <0x325aa0>;
		gpio = <&{/pinctrl/gpio@fe760000} 0x13 0x00>;
		regulator-min-microvolt = <0x325aa0>;
		regulator-name = "minipcie_power";
	};
	gpio-regulator {
		compatible = "regulator-fixed";
		regulator-max-microvolt = <0x325aa0>;
		gpio = <&{/pinctrl/gpio@fdd60000} 0x1c 0x00>;
		regulator-min-microvolt = <0x325aa0>;
		regulator-name = "vcc3v3_pcie";
		startup-delay-us = <0x1388>;
		vin-supply = <&{/dc-12v}>;
	};
	leds {
		compatible = "gpio-leds";

		gpio1a4 {
			default-state = "off";
			gpios = <&{/pinctrl/gpio@fe740000} 0x04 0x00>;
		};

		gpio4c4 {
			default-state = "off";
			gpios = <&{/pinctrl/gpio@fe770000} 0x14 0x00>;
		};

		gpio1b2 {
			default-state = "off";
			gpios = <&{/pinctrl/gpio@fe740000} 0x0a 0x00>;
		};

		gpio1d0 {
			default-state = "off";
			gpios = <&{/pinctrl/gpio@fe740000} 0x18 0x00>;
		};

		gpio1b0 {
			default-state = "off";
			gpios = <&{/pinctrl/gpio@fe740000} 0x08 0x00>;
		};

		gpio3b6 {
			default-state = "off";
			gpios = <&{/pinctrl/gpio@fe760000} 0x0e 0x00>;
		};

		gpio1b1 {
			default-state = "off";
			gpios = <&{/pinctrl/gpio@fe740000} 0x09 0x00>;
		};

		gpio3b5 {
			default-state = "off";
			gpios = <&{/pinctrl/gpio@fe760000} 0x0d 0x00>;
		};

		fan {
			default-state = "on";
			gpios = <&{/pinctrl/gpio@fdd60000} 0x1e 0x00>;
		};

		work-led {
			linux,default-trigger = "heartbeat";
			gpios = <&{/pinctrl/gpio@fdd60000} 0x1d 0x00>;
		};

		gpio1d4 {
			default-state = "off";
			gpios = <&{/pinctrl/gpio@fe740000} 0x1c 0x00>;
		};
	};
	adc-keys {
	io-channels = <&{/saradc@fe720000} 0x00>;
	poll-interval = <0x64>;
	keyup-threshold-microvolt = <0x1b7740>;
	compatible = "adc-keys";
	io-channel-names = "buttons";
	vol-up-key {
	press-threshold-microvolt = <0x6d6>;
	label = "volume up";
	linux,code = <0x73>;
	};
	};
	bus-npu {
	compatible = "rockchip,rk3568-bus";
	status = "okay";
	
	clock-names = "bus";
	rockchip,busfreq-policy = "clkfreq";
	clocks = <&{/firmware/scmi/protocol@14} 0x02>;
	bus-supply = <&{/i2c@fdd40000/pmic@20/regulators/DCDC_REG1}>;
	operating-points-v2 = <&{/bus-npu-opp-table}>;
	pvtm-supply = <&{/i2c@fdd40000/regulator@1c}>;};
	bus-npu-opp-table {
	rockchip,pvtm-ch = <0x00 0x05>;
	opp-shared;
	compatible = "operating-points-v2";
	nvmem-cell-names = "pvtm";
	rockchip,pvtm-voltage-sel = <0x00 0x14820 0x00 0x14821 0x16378 0x01 0x16379 0x186a0 0x02>;
	opp-700000000 {
	opp-microvolt = <0xdbba0>;
	opp-microvolt-L2 = <0xd59f8>;
	opp-hz = <0x00 0x29b92700>;
	opp-microvolt-L0 = <0xdbba0>;
	opp-microvolt-L1 = <0xd59f8>;
	};
	opp-900000000 {
	opp-microvolt = <0xdbba0>;
	opp-hz = <0x00 0x35a4e900>;
	};
	opp-1000000000 {
	opp-microvolt = <0xe7ef0>;
	opp-microvolt-L2 = <0xdbba0>;
	opp-hz = <0x00 0x3b9aca00>;
	opp-microvolt-L0 = <0xe7ef0>;
	opp-microvolt-L1 = <0xe1d48>;
	};
	};
	cpu0-opp-table {
	rockchip,pvtm-sample-time = <0x3e8>;
	rockchip,pvtm-ch = <0x00 0x05>;
	nvmem-cells = <&{/efuse@fe38c000/nvmem-layout/cpu-leakage@1a} 0x07 &{/power-management@fdd90000/power-controller/power-domain@9} 0x09 &{/power-management@fdd90000/power-controller/power-domain@7} 0x0b>;
	rockchip,pvtm-number = <0x0a>;
	rockchip,low-temp = <0x00>;
	opp-shared;
	rockchip,max-volt = <0x118c30>;
	rockchip,pvtm-freq = <0x639c0>;
	rockchip,pvtm-ref-temp = <0x28>;
	rockchip,thermal-zone = "soc-thermal";
	rockchip,low-temp-adjust-volt = <0x00 0x7c8 0x124f8>;
	compatible = "operating-points-v2";
	nvmem-cell-names = "leakage", "pvtm", "mbist-vmin", "opp-info", "specification_serial_number", "remark_spec_serial_number";
	rockchip,pvtm-voltage-sel = <0x00 0x14820 0x00 0x14821 0x153d8 0x01 0x153d9 0x16378 0x02 0x16379 0x186a0 0x03>;
	rockchip,pvtm-temp-prop = <0x1a 0x1a>;
	rockchip,temp-hysteresis = <0x1388>;
	rockchip,supported-hw;
	rockchip,pvtm-error = <0x3e8>;
	mbist-vmin = <0xc96a8 0xdbba0 0xe7ef0>;
	rockchip,pvtm-volt = <0xdbba0>;
	opp-1992000000 {
	opp-microvolt = <0x118c30 0x118c30 0x118c30>;
	opp-microvolt-L2 = <0x112a88 0x112a88 0x118c30>;
	opp-hz = <0x00 0x76bb8200>;
	opp-microvolt-L0 = <0x118c30 0x118c30 0x118c30>;
	opp-supported-hw = <0xf9 0xffff>;
	opp-microvolt-L3 = <0x10c8e0 0x10c8e0 0x118c30>;
	clock-latency-ns = <0x9c40>;
	opp-microvolt-L1 = <0x118c30 0x118c30 0x118c30>;
	};
	opp-m-1608000000 {
	opp-microvolt = <0xf4240 0xf4240 0x118c30>;
	opp-hz = <0x00 0x5fd82200>;
	opp-supported-hw = <0x02 0xffff>;
	clock-latency-ns = <0x9c40>;
	};
	opp-j-1416000000 {
	opp-microvolt = <0xdbba0 0xdbba0 0x118c30>;
	opp-hz = <0x00 0x54667200>;
	opp-supported-hw = <0x04 0xffff>;
	clock-latency-ns = <0x9c40>;
	};
	opp-1800000000 {
	opp-microvolt = <0x118c30 0x118c30 0x118c30>;
	opp-microvolt-L2 = <0x106738 0x106738 0x118c30>;
	opp-hz = <0x00 0x6b49d200>;
	opp-microvolt-L0 = <0x118c30 0x118c30 0x118c30>;
	opp-supported-hw = <0xf9 0xffff>;
	opp-microvolt-L3 = <0x100590 0x100590 0x118c30>;
	clock-latency-ns = <0x9c40>;
	opp-microvolt-L1 = <0x10c8e0 0x10c8e0 0x118c30>;
