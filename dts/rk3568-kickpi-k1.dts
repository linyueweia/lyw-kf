		phys = <&{/phy@fe8c0000}>;
		phy-names = "pcie-phy";
		power-domains = <&{/power-management@fdd90000/power-controller} 0x0f>;
		reg = <0x03 0xc0800000 0x00 0x400000 0x00 0xfe280000 0x00 0x10000 0x00 0xf0000000 0x00 0x100000>;
		ranges = <0x1000000 0x00 0xf0100000 0x00 0xf0100000 0x00 0x100000 0x2000000 0x00 0xf0200000 0x00 0xf0200000 0x00 0x1e00000 0x3000000 0x03 0x80000000 0x03 0x80000000 0x00 0x40000000>;
		reg-names = "dbi", "apb", "config";
		resets = <&{/clock-controller@fdd20000} 0xc1>;
		reset-names = "pipe";
		status = "okay";
		legacy-interrupt-controller {
			interrupt-controller;
			interrupt-parent = <0x01>;
			phandle = <0xca>;
		};
	};

	ethernet@fe2a0000 {
		compatible = "rockchip,rk3568-gmac\0snps,dwmac-4.20a";
		snps,mixed-burst;
		snps,tso;
		assigned-clock-parents = <0x0f 0x183 0x0f 0xb6>;
		assigned-clock-rates = <0x00 0x7735940>;
		clock_in_out = "output";
		phy-mode = "rgmii";
		pinctrl-0 = <0xcf 0xd0 0xd1 0xd2 0xd3>;
		snps,reset-gpio = <&{/pinctrl/gpio@fe750000} 0x1b 0x01>;
		snps,reset-active-low;
		snps,reset-delays-us = <0x00 0x4e20 0x186a0>;
		tx_delay = <0x21>;
		rx_delay = <0x3c>;
		phy-handle = <0xd4>;
		phandle = <0x27e>;

		reg = <0x00 0xfe2a0000 0x00 0x10000>;
		interrupts = <0x00 0x1b 0x04 0x00 0x18 0x04>;
		interrupt-names = "macirq", "eth_wake_irq";
		clocks = <&{/clock-controller@fdd20000} 0x182 &{/clock-controller@fdd20000} 0x185 &{/clock-controller@fdd20000} 0x185 &{/clock-controller@fdd20000} 0xb8 &{/clock-controller@fdd20000} 0xb4 &{/clock-controller@fdd20000} 0xb5 &{/clock-controller@fdd20000} 0x185 &{/clock-controller@fdd20000} 0xb9 &{/clock-controller@fdd20000} 0xac>;
		clock-names = "stmmaceth", "mac_clk_rx", "mac_clk_tx", "clk_mac_refout", "aclk_mac", "pclk_mac", "clk_mac_speed", "ptp_ref", "pclk_xpcs";
		resets = <&{/clock-controller@fdd20000} 0xd7>;
		reset-names = "stmmaceth";
		rockchip,grf = <&{/syscon@fdc60000}>;
		status = "okay";
		assigned-clocks = <&{/clock-controller@fdd20000} 0x185 &{/clock-controller@fdd20000} 0x182>;
		pinctrl-names = "default";
		snps,axi-config = <&{/ethernet@fe2a0000/stmmac-axi-config}>;
		snps,mtl-rx-config = <&{/ethernet@fe2a0000/rx-queues-config}>;
		snps,mtl-tx-config = <&{/ethernet@fe2a0000/tx-queues-config}>;
		mdio {
			compatible = "snps,dwmac-mdio";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			phandle = <0x27f>;

			ethernet-phy@0 {
				reg = <0x00>;
				compatible = "ethernet-phy-ieee802.3-c22";
				phandle = <0xd4>;
			};
		};

		stmmac-axi-config {
			snps,blen = <0x00 0x00 0x00 0x00 0x10 0x08 0x04>;
			snps,rd_osr_lmt = <0x08>;
			snps,wr_osr_lmt = <0x04>;
			phandle = <0xcc>;
		};

		rx-queues-config {
			snps,rx-queues-to-use = <0x01>;
			phandle = <0xcd>;

			queue0 {
			};
		};

		tx-queues-config {
			snps,tx-queues-to-use = <0x01>;
			phandle = <0xce>;

			queue0 {
			};
		};
	};

	can@fe570000 {
		compatible = "rockchip,rk3568v2-canfd";
		reg = <0x00 0xfe570000 0x00 0x1000>;
		interrupts = <0x00 0x01 0x04>;
		clocks = <0x0f 0x141 0x0f 0x140>;
		clock-names = "baud\0pclk";
		resets = <0x0f 0x155 0x0f 0x154>;
		reset-names = "core\0apb";
		pinctrl-names = "default";
		pinctrl-0 = <0xd5>;
		status = "disabled";
		phandle = <0x280>;
	};

	can@fe580000 {
		compatible = "rockchip,rk3568v2-canfd";
		reg = <0x00 0xfe580000 0x00 0x1000>;
		interrupts = <0x00 0x02 0x04>;
		clocks = <0x0f 0x143 0x0f 0x142>;
		clock-names = "baud\0pclk";
		resets = <0x0f 0x157 0x0f 0x156>;
		reset-names = "core\0apb";
		pinctrl-names = "default";
		pinctrl-0 = <0xd6>;
		status = "disabled";
		phandle = <0x281>;
	};

	can@fe590000 {
		compatible = "rockchip,rk3568v2-canfd";
		reg = <0x00 0xfe590000 0x00 0x1000>;
		interrupts = <0x00 0x03 0x04>;
		clocks = <0x0f 0x145 0x0f 0x144>;
		clock-names = "baud\0pclk";
		resets = <0x0f 0x159 0x0f 0x158>;
		reset-names = "core\0apb";
		pinctrl-names = "default";
		pinctrl-0 = <0xd7>;
		status = "disabled";
		phandle = <0x282>;
	};

	phy@fe820000 {
		compatible = "rockchip,rk3568-naneng-combphy";
		status = "okay";
		phandle = <0x14>;
	
		rockchip,pipe-grf = <&{/syscon@fdc50000}>;
		clock-names = "refclk", "apbclk", "pipe_clk";
		assigned-clocks = <&{/clock-controller@fdd00000} 0x1f>;
		assigned-clock-rates = <0x5f5e100>;
		resets = <&{/clock-controller@fdd20000} 0x1c4 0x24 0x1c5>;
		clocks = <&{/clock-controller@fdd00000} 0x1f &{/clock-controller@fdd20000} 0x17c &{/clock-controller@fdd20000} 0x7f>;
		#phy-cells = <0x01>;
		rockchip,pipe-phy-grf = <&{/syscon@fdc70000}>;
		reg = <0x00 0xfe820000 0x00 0x100>;
		reset-names = "combphy-apb", "combphy";};

	chosen {
		stdout-path = "serial2:1500000n8";
		phandle = <0x283>;
	};

	hdmi-con {
		compatible = "hdmi-connector";
		type = [61 00];

		port {

			endpoint {
				remote-endpoint = <0xd9>;
				phandle = <0x62>;
			};
		};
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <0xda>;

		reset {
			label = "reset";
			gpios = <0x56 0x09 0x01>;
			linux,code = <0x198>;
			debounce-interval = <0x32>;
		};
	};


